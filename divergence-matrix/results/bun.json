{
  "runtime": "bun",
  "version": "1.3.14",
  "tests": [
    {
      "id": "module-surface",
      "ok": true,
      "note": "keys: Channel,channel,hasSubscribers,subscribe,tracingChannel,unsubscribe"
    },
    {
      "id": "channel-singleton",
      "ok": true,
      "note": "{\"same\":true,\"name\":true,\"subscribe\":true,\"unsubscribe\":true,\"publish\":true}, name value: string, hasSubscribers type: boolean"
    },
    {
      "id": "string-publish",
      "ok": true,
      "note": "fired: 1, unsub returns: true, has after: false"
    },
    {
      "id": "symbol-names",
      "ok": true,
      "note": "has: true, fired: 1, channel(): object"
    },
    {
      "id": "subscriber-order",
      "ok": true,
      "note": "order: 1,2"
    },
    {
      "id": "subscriber-error",
      "ok": true,
      "note": "publish threw synchronously: false, second subscriber ran: true, deferred uncaught: boom"
    },
    {
      "id": "tracingchannel-surface",
      "ok": true,
      "note": "start=tracing:p:tc:start | end=tracing:p:tc:end | asyncStart=tracing:p:tc:asyncStart | asyncEnd=tracing:p:tc:asyncEnd | error=tracing:p:tc:error | traceSync=function,tracePromise=function,traceCallback=function"
    },
    {
      "id": "trace-promise",
      "ok": true,
      "note": "events: start,end:undefined,asyncStart,asyncEnd, ctx identity: true, out: {\"v\":42}"
    },
    {
      "id": "trace-promise-reject",
      "ok": true,
      "note": "events: start,end,error,asyncStart,asyncEnd, rejected: true, ctx.error: boom"
    },
    {
      "id": "trace-callback",
      "ok": true,
      "note": "events: start,asyncStart,cb:42,asyncEnd,end"
    },
    {
      "id": "trace-sync",
      "ok": true,
      "note": "events: start,end, out: 7"
    },
    {
      "id": "bind-store-runstores",
      "ok": true,
      "note": "inside: {\"from\":{\"tag\":\"bs\"}}, after: undefined"
    },
    {
      "id": "tracingchannel-restore",
      "ok": true,
      "note": "start store: tc, asyncStart store: tc"
    }
  ]
}
